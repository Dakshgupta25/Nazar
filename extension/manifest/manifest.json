{
  "manifest_version": 3,
  "name": "Nazar Edge",
  "version": "0.1.0",
  "description": "Privacy-preserving computer vision tool on the edge.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Nazar Metrics HUD"
  }
}
