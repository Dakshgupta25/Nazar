{
  "manifest_version": 3,
  "name": "Visual Privacy Extension",
  "version": "0.1.0",
  "description": "Privacy-preserving visual sanitization extension foundation",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Visual Privacy Extension"
  },
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "permissions": [],
  "web_accessible_resources": [
    {
      "resources": [
        "models/ocr/*",
        "models/blazeface/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
