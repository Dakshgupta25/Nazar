{
  "manifest_version": 3,
  "name": "NAZAR — Local Privacy Firewall",
  "version": "0.1.0",
  "description": "Local Privacy Firewall for AI Agents. Ensures sensitive context stays local.",
  "homepage_url": "https://nazarofficial.vercel.app/",
  "author": "nazarofficial.in@gmail.com",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NAZAR Privacy Firewall"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}